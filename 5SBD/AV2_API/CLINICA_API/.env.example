# Autenticação Windows (padrão)
DB_SERVER=localhost
DB_NAME=AV2_SBD
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TIMEOUT=5

# Para autenticação do SQL Server, preencha também:
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha

# Alternativamente, informe a URL completa e ignore as variáveis acima:
# DATABASE_URL=mssql+pyodbc://usuario:senha@localhost/AV2_SBD?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
